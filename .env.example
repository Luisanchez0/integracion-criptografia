# Copiar a .env o ejecutar: python scripts/setup_env.py
# Los valores vacíos deben generarse; no son secretos de ejemplo reutilizables.
SECRET_KEY=
# AES de 32 bytes, Base64 estándar: python scripts/setup_env.py lo genera.
AES_KEY=
DATABASE_PATH=instance/gestor.sqlite3
STORAGE_PATH=storage/documents
ED25519_PRIVATE_KEY_PATH=instance/keys/ed25519_private.pem
ED25519_PUBLIC_KEY_PATH=instance/keys/ed25519_public.pem
MAX_UPLOAD_BYTES=5242880
SESSION_COOKIE_SECURE=false
# Solo localhost; debug desactivado salvo opción explícita --debug de Flask.
